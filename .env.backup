# ───────────────────────────────────────────────────────────────────────
# TERRAGRID PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.backup)
# ───────────────────────────────────────────────────────────────────────
# Use this template to build your local .env file.
# IMPORTANT: Never commit or push any file containing actual secret keys to git!
# Always add .env (and other private backup files) to your .gitignore.
# ───────────────────────────────────────────────────────────────────────

# 🗄️ PostgreSQL Database
# HOW TO GET: Set up local PostgreSQL via Docker Compose or obtain cloud database credentials.
# CONNECTION FORMAT: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/terragrid_db

# ☁️ Google Cloud Platform Configuration
# HOW TO GET: Sign up on GCP Console (https://console.cloud.google.com), create a project.
# CREDENTIALS: Set up a Service Account, generate a JSON Key file, and save it locally as gcp-credentials.json.
GCP_PROJECT_ID=terragrid-platform
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GEMINI_LOCATION=us-central1

# 🏔️ Critical Disaster Ingestion APIs (No Auth Required - Free & Open)
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1

# 🌦️ NOAA Climate & Weather Data
# HOW TO GET KEY: 
# 1. Visit NOAA Climate Data Online (https://www.ncdc.noaa.gov/cdo-web/token).
# 2. Enter your email address to request a token.
# 3. NOAA will email you an API Token key immediately. Paste it here.
NOAA_API_KEY=your_noaa_token_from_email
NOAA_API_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2

# 🧠 Gemini AI (Cascade Analysis & Threat Modeling)
# HOW TO GET: Handled automatically when GOOGLE_APPLICATION_CREDENTIALS JSON key is configured.
GEMINI_MODEL=gemini-3.8-flash

# 🗺️ Google Maps API (Evacuation Routing)
# HOW TO GET KEY:
# 1. Open Google Cloud Console, select your project.
# 2. Go to APIs & Services > Credentials.
# 3. Click "+ Create Credentials" > API Key.
# 4. Enable "Maps JavaScript API" and "Directions API" under the API Library.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_from_console
GOOGLE_MAPS_PROJECT_ID=terragrid-platform

# 📍 Overpass/OpenStreetMap API (Infrastructure Mapping - No Auth)
# HOW TO GET: Public open-source API, no key required.
# PURPOSE: Maps hospitals, power substations, shelters, and roads near active hazards.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPENSTREETMAP_DATA_SOURCE=openstreetmap
OVERPASS_RATE_LIMIT_QPS=2
OVERPASS_BACKOFF_SECONDS=10

# 🔌 PowerOutage.us API (Cascade Failure Modeling - No Auth)
# HOW TO GET: Public API, no key needed.
# PURPOSE: Tracks real-time grid and power outage cascades.
POWEROUTAGE_API_URL=https://poweroutage.us/api
POWEROUTAGE_RATE_LIMIT_RPS=1
POWEROUTAGE_BACKOFF_SECONDS=5

# 🔔 GDACS API (Global Disaster Coordination System - No Auth)
# HOW TO GET: Public API, no key needed.
# PURPOSE: Multi-hazard feeds (cyclones, floods, tsunamis, earthquakes).
GDACS_API_URL=https://www.gdacs.org/api/v1/events

# ☀️ OpenWeatherMap API (Weather & Climate Data - OPTIONAL)
# HOW TO GET KEY:
# 1. Register a free account at OpenWeatherMap (https://openweathermap.org/api).
# 2. Go to your Account > API Keys dashboard and copy your automatically generated key.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_from_dashboard

# 🇺🇳 ReliefWeb API (Humanitarian Reports & Updates)
# HOW TO GET: No key needed, but specify your application name to increase rate limits.
# APPNAME: register your custom app identifier (e.g. your-app-name).
RELIEFWEB_APPNAME=terragrid-disaster-ai
RELIEFWEB_API_URL=https://api.reliefweb.int/v1

# ✉️ Resend Email API - DEPRECATED, no longer used anywhere. Both RESPONSE
# phase's automatic critical-incident email (send_critical_alert) AND
# PREPARE phase's manual Agency Alerts email (send_alert_email) now send
# via the single Gmail SMTP account configured below - there is no Resend
# dependency left in backend/services/notifications.py. Safe to leave these
# three vars out of your .env entirely; they're kept here only so an old
# .env with them set doesn't fail to parse.
# RESEND_API_KEY=re_your_api_key_from_resend_dashboard
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=TerraGrid Alerts

# ✉️ Gmail SMTP - sends BOTH of TerraGrid's email paths:
#   1. RESPONSE phase's automatic critical-incident email (send_critical_alert),
#      to recipients added under Settings > Critical Alert Recipients
#      (alert_recipients table, channel='critical_email').
#   2. PREPARE phase's manual Agency Alerts email (send_alert_email), to
#      recipients added under Settings > Email Recipients
#      (alert_recipients table, channel='email').
# Both lists are runtime-editable from the Settings screen, not env vars -
# nothing to configure here besides the sender account itself. Previously
# RESPONSE phase used Resend with recipients fixed in ALERT_RECIPIENTS
# (also deprecated below, same reason) - now both paths share Gmail SMTP.
# HOW TO GET:
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the Gmail address and the 16-character App Password below.
#    This is NOT your normal Gmail password - never put your real
#    password here.
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-character-app-password
GMAIL_SMTP_FROM_NAME=TerraGrid Alerts

# DEPRECATED, no longer read anywhere - RESPONSE phase's critical-alert
# recipients are now managed at runtime via Settings > Critical Alert
# Recipients (see Gmail SMTP block above), not this env var.
# ALERT_RECIPIENTS=test@example.com

# 📱 httpSMS API (SMS Notifications via personal Android Phone)
# HOW TO GET KEY:
# 1. Go to httpSMS (https://httpsms.com) and sign up.
# 2. Install the httpSMS Android App on your smartphone.
# 3. Copy your API Key from the web dashboard.
# PURPOSE: Broadcast SMS alerts using your own SIM carrier with zero SMS charges.
HTTPSMS_API_KEY=your_httpsms_api_key_from_dashboard
HTTPSMS_API_URL=https://api.httpsms.com/v1
HTTPSMS_PHONE_NUMBER=+1234567890

# ⚙️ Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=info

# Background data fetch interval in minutes (default: 15 for prod, use 1 for local testing)
POLLING_INTERVAL_MINUTES=15
