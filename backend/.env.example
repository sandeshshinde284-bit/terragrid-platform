# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/terragrid

# API Keys and Secrets
SECRET_KEY=your-secret-key-here

# Gemini AI API Configuration
# Get your FREE API key from: https://aistudio.google.com/
# Steps:
#   1. Visit https://aistudio.google.com/
#   2. Click "Create new project" 
#   3. Go to "API keys" section
#   4. Click "Create API key"
#   5. Copy the key and paste it below
#
# Rate limits: 60 requests/min (FREE tier)
# Cost: FREE for development and hackathon
# Docs: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Logging
LOG_LEVEL=INFO

# Email Configuration (Optional - for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=alerts@terragrid.local

# Data Sources
NOAA_API_ENDPOINT=https://api.weather.gov
GDACS_API_ENDPOINT=https://www.gdacs.org/api
EONET_API_ENDPOINT=https://eonet.gsfc.nasa.gov/api/v3
